type ExternalFileInfo struct {
	ID   string `json:"id"`
	Name string `json:"name"`
}

type ExternalAttachment struct {
	DocType string             `json:"docType"`
	Files   []ExternalFileInfo `json:"files"`
}

type ExternalInquiryAdditionalData struct {
	Description string               `json:"description"`
	Attachments []ExternalAttachment `json:"attachments,omitempty"`
}

type ExternalInquiryPayload struct {
	BIN            string                        `json:"bin"`
	Type           string                        `json:"type,omitempty"`
	Subject        string                        `json:"subject,omitempty"`
	AdditionalData ExternalInquiryAdditionalData `json:"additionalData"`
}

func AFCreateInquiryHandler(c echo.Context) error {
	incidentID := c.Param("id")
	if incidentID == "" {
		return c.JSON(http.StatusBadRequest, echo.Map{"error": "Incident ID is required"})
	}

	// 1. Парсим multipart-форму до чтения текстовых полей
	if err := c.Request().ParseMultipartForm(32 << 20); err != nil {
		fmt.Printf("[MULTIPART PARSE INFO]: %v\n", err)
	}

	targetBIN := strings.TrimSpace(c.FormValue("target_bin"))
	description := strings.TrimSpace(c.FormValue("description"))
	inquiryType := strings.TrimSpace(c.FormValue("type"))
	docType := strings.TrimSpace(c.FormValue("doc_type")) // Например "PAYMENT_POYNT" или "OTHER"
	if inquiryType == "" {
		inquiryType = "MANUAL"
	}
	if docType == "" {
		docType = "PAYMENT_POYNT"
	}

	if targetBIN == "" {
		return c.JSON(http.StatusBadRequest, echo.Map{"error": "Необходимо выбрать целевую организацию"})
	}
	if description == "" {
		return c.JSON(http.StatusBadRequest, echo.Map{"error": "Описание запроса не может быть пустым"})
	}

	// 2. Авторизация
	authData, _ := model.AFGetAuthStruct()
	if int(time.Since(authData.CreatedAt).Seconds()) >= authData.RefreshExpiresIn {
		var err error
		authData, _, err = model.AFAuth("create_inquiry token expired")
		if err != nil {
			logger.Log("ERROR", "inquiry_handler", incidentID, "AFAuth fiasco", err)
			return c.JSON(http.StatusInternalServerError, echo.Map{"error": "Authentication failed"})
		}
	}
	model.AFGlobalAuthData = authData

	baseURL := strings.TrimRight(comps.Config.AF_APIURL, "/")

	// 3. Обработка и выгрузка файлов во внешний сервис
	var uploadedFiles []ExternalFileInfo
	form, err := c.MultipartForm()

	if err == nil && form != nil && form.File != nil {
		var files []*multipart.FileHeader
		if f, ok := form.File["files"]; ok {
			files = f
		} else if f, ok := form.File["files[]"]; ok {
			files = f
		}

		if len(files) > 0 {
			allowedExts := map[string]bool{".png": true, ".jpg": true, ".jpeg": true, ".pdf": true}
			const maxFileSize = 10 * 1024 * 1024

			uploadFileURL := fmt.Sprintf("%s/external/v1/files?target=INCIDENT_FILES", baseURL)

			for _, fileHeader := range files {
				if fileHeader.Size > maxFileSize {
					return c.JSON(http.StatusBadRequest, echo.Map{
						"error": fmt.Sprintf("Файл %s превышает предел в 10MB", fileHeader.Filename),
					})
				}

				ext := strings.ToLower(filepath.Ext(fileHeader.Filename))
				if !allowedExts[ext] {
					return c.JSON(http.StatusBadRequest, echo.Map{
						"error": fmt.Sprintf("Формат %s недопустим. Разрешены: PDF, PNG, JPG", ext),
					})
				}

				// Этап 1: Загружаем файл во внешний сервис и получаем ID
				fileID, err := uploadFileToExternal(uploadFileURL, fileHeader, authData.AccessToken)
				if err != nil {
					logger.Log("ERROR", "inquiry_handler", incidentID, "File upload failed", err)
					return c.JSON(http.StatusInternalServerError, echo.Map{
						"error": fmt.Sprintf("Ошибка загрузки файла %s во внешний сервис", fileHeader.Filename),
					})
				}

				// Этап 2: Сохраняем связку id и name
				uploadedFiles = append(uploadedFiles, ExternalFileInfo{
					ID:   fileID,
					Name: fileHeader.Filename,
				})
			}
		}
	}

	// 4. Формируем дополнительный массив attachments по спецификации
	var attachments []ExternalAttachment
	if len(uploadedFiles) > 0 {
		attachments = append(attachments, ExternalAttachment{
			DocType: docType,
			Files:   uploadedFiles,
		})
	}

	// 5. Итоговый Payload точно по документу
	reqPayload := ExternalInquiryPayload{
		BIN: targetBIN, // БИН получателя/целевой организации
		AdditionalData: ExternalInquiryAdditionalData{
			Description: description,
			Attachments: attachments,
		},
	}

	jsonPayload, err := json.Marshal(reqPayload)
	if err != nil {
		return c.JSON(http.StatusInternalServerError, echo.Map{"error": "Failed to prepare payload"})
	}

	// 6. Отправка POST запроса создания инцидента
	targetURL := fmt.Sprintf("%s/external/v1/incidents/%s/inquiries", baseURL, incidentID)
	body, status, err := sendPostInquiry(targetURL, jsonPayload, authData.AccessToken)
	if err != nil {
		return c.JSON(http.StatusInternalServerError, echo.Map{"error": "Failed to connect to external service"})
	}

	if status == http.StatusUnauthorized {
		return c.JSON(http.StatusUnauthorized, echo.Map{"error": "Unauthorized in external service"})
	}

	if status >= 200 && status < 300 {
		if errRaw := SaveCreateInquiryRawTarget(reqPayload, body, status, incidentID); errRaw != nil {
			logger.Log("ERROR", "inquiry_handler", incidentID, "Save DB fiasco", errRaw)
			return c.JSON(http.StatusInternalServerError, echo.Map{"error": "Failed to save inquiry data"})
		}

		return c.JSON(http.StatusOK, echo.Map{
			"message": "Inquiry created successfully",
			"status":  status,
		})
	}

	return c.JSON(status, echo.Map{
		"error":   "External service error",
		"status":  status,
		"details": string(body),
	})
}
